# EditorConfig — keeps editors in sync with the pre-commit rules.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Web / config files conventionally use 2-space indent
[*.{js,jsx,ts,tsx,mjs,cjs,vue,json,jsonc,css,scss,html,yml,yaml}]
indent_size = 2

# Markdown: trailing whitespace can be meaningful (hard line break)
[*.md]
trim_trailing_whitespace = false

# Windows-only scripts keep CRLF
[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
