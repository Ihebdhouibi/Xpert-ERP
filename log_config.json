{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s - %(name)-12s - %(levelname)-8s - %(message)s"
    },
    "access": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(asctime)s - uvicorn.access  - INFO     - %(client_addr)s - \"%(request_line)s\" %(status_code)s",
      "use_colors": false
    }
  },
  "handlers": {
    "console_default": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stderr"
    },
    "console_access": {
      "class": "logging.StreamHandler",
      "formatter": "access",
      "stream": "ext://sys.stdout"
    },
    "file_uvicorn": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "default",
      "filename": "logs/uvicorn.log",
      "maxBytes": 10485760,
      "backupCount": 5,
      "encoding": "utf-8"
    },
    "file_access": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "access",
      "filename": "logs/uvicorn.log",
      "maxBytes": 10485760,
      "backupCount": 5,
      "encoding": "utf-8"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["console_default", "file_uvicorn"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["console_default", "file_uvicorn"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["console_access", "file_access"],
      "level": "INFO",
      "propagate": false
    }
  }
}
