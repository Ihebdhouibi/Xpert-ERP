# =============================================================================
# Xpert-ERP — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -- Application --------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_VERSION=0.1.0

# -- Database -----------------------------------------------------------------
POSTGRES_USER=xpert
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=xpert_erp
DATABASE_URL=postgresql+asyncpg://xpert:change_me_in_production@localhost:5432/xpert_erp
DATABASE_ECHO=false

# -- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@localhost:6379/0

# -- Object Storage (MinIO / S3-compatible) -----------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_in_production
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=change_me_in_production
S3_BUCKET_DOCUMENTS=xpert-documents
S3_BUCKET_MEDIA=xpert-media
S3_REGION=us-east-1

# -- Security -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_64_BYTE_HEX_SECRET
ALGORITHM=HS256

# -- CORS ---------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:5173"]

# -- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# -- PDF / Garage branding (CFG_* — configurable, not hard-coded) -------------
PDF_GARAGE_NAME=My Garage
PDF_GARAGE_ADDRESS=123 Rue Example, 1000 Tunis
PDF_GARAGE_PHONE=+216 71 000 000
PDF_GARAGE_EMAIL=contact@mygarage.tn
PDF_GARAGE_LOGO_PATH=               # Absolute path to logo image file, or empty
PDF_VAT_NUMBER=
PDF_LEGAL_MENTION=                  # e.g. SARL au capital de 10 000 DT — RC 12345
PDF_BANK_IBAN=
PDF_BANK_BIC=
PDF_BANK_HOLDER=
PDF_FOOTER_TEXT=
PDF_CURRENCY_SYMBOL=€
PDF_PAYMENT_TERMS=Paiement à 30 jours
CFG_GTK3_DLL_DIR=                    # Windows only: C:\GTK3\bin — leave blank on Linux/Docker
CFG_ALLOW_NEGATIVE_STOCK=false       # Allow on-hand stock to go negative

# -- SMTP ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=noreply@xpert-erp.local
SMTP_FROM_NAME=Xpert-ERP
# Comma-separated address(es) notified for "send to admin" and internal alert emails
CFG_ADMIN_NOTIFICATION_EMAILS=

# -- Backup -------------------------------------------------------------------
# Separate S3 bucket/credentials for backups (use a dedicated IAM user in prod)
BACKUP_S3_BUCKET=xpert-backups
BACKUP_S3_ENDPOINT=https://s3.amazonaws.com  # override with MinIO URL for local dev
BACKUP_S3_ACCESS_KEY=                        # dedicated backup IAM key
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=7                      # pg_dump files older than this are pruned
POSTGRES_HOST=db                             # hostname of PostgreSQL service (for pg_dump)
