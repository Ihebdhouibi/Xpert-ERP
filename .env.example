# =============================================================================
# Xpert-ERP — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -- Application --------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_VERSION=0.1.0

# -- Database -----------------------------------------------------------------
POSTGRES_USER=xpert
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=xpert_erp
DATABASE_URL=postgresql+asyncpg://xpert:change_me_in_production@localhost:5432/xpert_erp
DATABASE_ECHO=false

# -- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@localhost:6379/0

# -- Object Storage (MinIO / S3-compatible) -----------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_in_production
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=change_me_in_production
S3_BUCKET_DOCUMENTS=xpert-documents
S3_BUCKET_MEDIA=xpert-media
S3_REGION=us-east-1

# -- Security -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_64_BYTE_HEX_SECRET
ALGORITHM=HS256

# -- CORS ---------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:5173"]

# -- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# -- SMTP ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=noreply@xpert-erp.local
SMTP_FROM_NAME=Xpert-ERP
