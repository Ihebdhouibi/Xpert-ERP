# =============================================================================
# Xpert-ERP — Production Environment Variables Template
# =============================================================================
# Copy this file to .env on the server and fill in ALL values marked <REQUIRED>.
# NEVER commit a filled .env to version control.
#
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(64))"
# =============================================================================

# -- Application --------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
APP_VERSION=1.0.0

# -- Database -----------------------------------------------------------------
POSTGRES_USER=<REQUIRED: e.g. xpert_prod>
POSTGRES_PASSWORD=<REQUIRED: strong random password>
POSTGRES_DB=<REQUIRED: e.g. xpert_erp_prod>
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# -- Redis --------------------------------------------------------------------
REDIS_PASSWORD=<REQUIRED: strong random password>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# -- Object Storage (MinIO) ---------------------------------------------------
MINIO_ROOT_USER=<REQUIRED: e.g. minio_admin>
MINIO_ROOT_PASSWORD=<REQUIRED: strong random password, min 8 chars>
S3_ENDPOINT_URL=http://minio:9000
# Public URL used in presigned download links sent to the browser
# Must be reachable from outside the server (use your domain or IP)
S3_PUBLIC_ENDPOINT_URL=https://<YOUR_DOMAIN_OR_IP>:9000
S3_ACCESS_KEY_ID=${MINIO_ROOT_USER}
S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET_DOCUMENTS=xpert-documents
S3_BUCKET_MEDIA=xpert-media
S3_REGION=us-east-1

# -- Security -----------------------------------------------------------------
# MUST be a long random hex string — any leak allows forging JWT tokens
SECRET_KEY=<REQUIRED: run: python -c "import secrets; print(secrets.token_hex(64))">
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (exact match)
ALLOWED_ORIGINS=["https://<YOUR_DOMAIN>"]

# -- Frontend -----------------------------------------------------------------
FRONTEND_BASE_URL=https://<YOUR_DOMAIN>

# -- Logging ------------------------------------------------------------------
# WARNING for production (avoids leaking data in logs), INFO for staging
LOG_LEVEL=WARNING
LOG_DIR=logs

# -- Email (SMTP) -------------------------------------------------------------
SMTP_HOST=<REQUIRED: your SMTP host>
SMTP_PORT=587
SMTP_USERNAME=<REQUIRED>
SMTP_PASSWORD=<REQUIRED>
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=<REQUIRED: e.g. noreply@motors-utilitaires.fr>
SMTP_FROM_NAME=Motors Utilitaires
CFG_ADMIN_NOTIFICATION_EMAILS=<OPTIONAL: comma-separated admin emails>

# -- PDF ----------------------------------------------------------------------
PDF_GARAGE_LOGO_PATH=/app/assets/logo.png

# -- Credit limit mode --------------------------------------------------------
# 'block'  = reject invoice/BL issuance when customer is over-limit
# 'warn'   = allow but show warning
CREDIT_LIMIT_MODE=block

# -- OCR Engine ---------------------------------------------------------------
CFG_OCR_ENGINE=onnx
CFG_OCR_USE_DOC_ORIENTATION=false
CFG_OCR_USE_DOC_UNWARPING=false
CFG_OCR_USE_TEXTLINE_ORIENTATION=false
