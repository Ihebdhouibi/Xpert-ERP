FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-xlib-2.0-0 \
    libffi-dev \
    shared-mime-info \
    fonts-liberation \
    fonts-dejavu-core \
    # Runtime libs required by OpenCV (cv2), pulled in transitively by PaddleOCR
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[dev]"

COPY . .

EXPOSE 8000
# Worker count, timeouts and recycling are defined in gunicorn.conf.py and are
# env-configurable (GUNICORN_WORKERS / WEB_CONCURRENCY). Default is 1 worker,
# which caps the in-process OCR model to a single instance for single-garage
# deployments. Bump GUNICORN_WORKERS to scale out.
CMD ["gunicorn", "app.main:app", "-c", "gunicorn.conf.py"]
