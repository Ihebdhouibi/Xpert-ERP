# syntax=docker/dockerfile:1
# Multi-stage build — mirrors the backend pattern.
#
#   Stage 1 (builder): installs deps + runs `vite build` → dist/
#   Stage 2 (runtime): nginx:alpine serves the static bundle and reverse-proxies /api

# ---------- builder ----------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Install deps first (cached layer when only source changes)
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Copy source and build
COPY . .
RUN npm run build

# ---------- runtime ----------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

# Remove default nginx page
RUN rm -rf /usr/share/nginx/html/*

# Copy the Vite build output
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy our Nginx site config (SPA fallback + /api proxy)
# nginx.conf lives in frontend/ (the build context root)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
