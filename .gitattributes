# Normalize line endings: store LF in the repo, auto-convert on checkout.
# This is the single most important line for avoiding CRLF/LF churn on Windows.
* text=auto eol=lf

# --- Source & text: always LF ---
*.py     text eol=lf
*.pyi    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.vue    text eol=lf
*.json   text eol=lf
*.jsonc  text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.ini    text eol=lf
*.cfg    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf
*.env    text eol=lf
*.dockerfile text eol=lf
Dockerfile   text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf

# --- Windows-only scripts: keep CRLF ---
*.bat    text eol=crlf
*.cmd    text eol=crlf

# --- Binary assets: never modified, never diffed ---
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    text eol=lf
*.webp   binary
*.pdf    binary
*.onnx   binary
*.pkl    binary
*.pdiparams binary
*.pdmodel   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.zip    binary
*.gz     binary
*.tar    binary
*.7z     binary
*.xlsx   binary
*.xls    binary
*.docx   binary
